# root patterns like runs/*/media/ are anchored at the repo root; these cover this project
.venv/
runs/scratch/
runs/**/media/
runs/*/*.png
runs/*/*.jpg
runs/*/*.mp4
runs/*/*.wav
logs/
MUJOCO_LOG.TXT
# m3d item builds: binaries are rebuildable from the logged prompt + seed; provenance (json, log) stays tracked
assets/**/*.glb
assets/**/*.usdz
assets/**/*.png
assets/**/*.obj
assets/**/*.jpg
assets/**/*.mtl
runs/**/strips/
runs/**/*.jpg
runs/**/*.png
# the stage fallback video is rebuilt from runs/s6-fallback-flight by tools/record_fallback.cjs
demo/*.mp4
# S7 real imagery: dataset files stay local (licence and size); provenance.json is tracked
assets/real/*/data/
